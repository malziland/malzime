{
  "_kommentar_firestore": "Einzige Datenbank: malzime-eu in europe-west1, ausgewaehlt ueber FIRESTORE_DATABASE_ID in functions/src/config.js. Die alte (default)-Datenbank (nam5, USA) wurde am 2026-08-11 geloescht — Ablauf und Beweisregel in docs/RUNBOOK.md, Abschnitt Firestore-Umzug.",
  "firestore": [
    {
      "database": "malzime-eu",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "_kommentar_functions": "ignore bestimmt, was als Server-Paket zu Google geht: nur das Programm (functions/src ohne Tests) samt package.json und package-lock.json. Ist die Liste gesetzt, gilt GENAU sie — node_modules und .git muessen deshalb selbst darin stehen. Jedes Muster ist ein blosser Datei- oder Ordnername ohne Schraegstrich; das Werkzeug vergleicht ihn auf jeder Ebene mit dem Namen (minimatch, matchBase und dot). Den Soll-Umfang haelt functions/src/__tests__/server-paket.test.js fest, Reste auf dem Auslieferungsrechner meldet scripts/pruefe-auslieferbare-reste.mjs (OPS-2026-10-03-09).",
  "functions": {
    "source": "functions",
    "runtime": "nodejs24",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.log",
      ".*",
      "__tests__",
      "coverage",
      "scripts",
      "eslint.config.js",
      "jest.setup.js"
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "pubsub": {
      "port": 8085
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/__tests__/**",
      "img/demo/original/**",
      "lib/PRUEFSUMMEN.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' https://nominatim.openstreetmap.org https://enqueue-5ymhpdpqcq-ew.a.run.app https://jobstatus-5ymhpdpqcq-ew.a.run.app https://stats-5ymhpdpqcq-ew.a.run.app https://errors-5ymhpdpqcq-ew.a.run.app https://telemetry-5ymhpdpqcq-ew.a.run.app; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains; preload"
          }
        ]
      },
      {
        "source": "/api/admin/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; form-action 'self'"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.woff2",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/stats",
        "function": {
          "functionId": "stats",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/errors",
        "function": {
          "functionId": "errors",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/telemetry",
        "function": {
          "functionId": "telemetry",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/enqueue",
        "function": {
          "functionId": "enqueue",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/job-status",
        "function": {
          "functionId": "jobStatus",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/admin/**",
        "function": {
          "functionId": "admin",
          "region": "europe-west1"
        }
      },
      {
        "source": "/stats",
        "destination": "/stats.html"
      },
      {
        "source": "/impressum",
        "destination": "/impressum.html"
      },
      {
        "source": "/datenschutz",
        "destination": "/datenschutz.html"
      },
      {
        "source": "/nutzungsbedingungen",
        "destination": "/nutzungsbedingungen.html"
      },
      {
        "source": "/barrierefreiheit",
        "destination": "/barrierefreiheit.html"
      },
      {
        "source": "/en/legal-notice",
        "destination": "/en/legal-notice.html"
      },
      {
        "source": "/en/privacy",
        "destination": "/en/privacy.html"
      },
      {
        "source": "/en/terms",
        "destination": "/en/terms.html"
      },
      {
        "source": "/en/accessibility",
        "destination": "/en/accessibility.html"
      },
      {
        "source": "/kurzvorstellung",
        "destination": "/kurzvorstellung.html"
      },
      {
        "source": "/en/introduction",
        "destination": "/en/introduction.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
