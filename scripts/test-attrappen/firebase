#!/bin/sh
# Attrappe fuer die Firebase-CLI. Tut nichts Echtes und scheitert auf Kommando.
#
# Steuerung ueber Umgebungsvariablen:
#   ATTRAPPE_FIREBASE_VERSION   was `firebase --version` ausgibt (Vorgabe 15.1.0)
#   ATTRAPPE_DRYRUN_ROT=1       jeder --dry-run scheitert
#   ATTRAPPE_FIRESTORE_ROT=1    der Firestore-Deploy scheitert
#   ATTRAPPE_HOSTING_ROT=1      der Hosting/Functions-Deploy scheitert
#
# Jeder Aufruf wird protokolliert, damit ein Test die REIHENFOLGE pruefen kann.
[ -n "${ATTRAPPE_PROTOKOLL:-}" ] && echo "firebase $*" >> "$ATTRAPPE_PROTOKOLL"

case "$1" in
  --version) echo "${ATTRAPPE_FIREBASE_VERSION:-15.1.0}"; exit 0 ;;
esac

IST_DRYRUN=0
for a in "$@"; do [ "$a" = "--dry-run" ] && IST_DRYRUN=1; done

if [ "$IST_DRYRUN" = "1" ]; then
  if [ "${ATTRAPPE_DRYRUN_ROT:-0}" = "1" ]; then
    echo "ATTRAPPE: Trockenlauf scheitert (so gewollt)." >&2
    exit 1
  fi
  echo "ATTRAPPE: compiled successfully (Trockenlauf)"
  exit 0
fi

case "$*" in
  *firestore*)
    if [ "${ATTRAPPE_FIRESTORE_ROT:-0}" = "1" ]; then
      echo "ATTRAPPE: Firestore-Deploy scheitert (so gewollt)." >&2
      exit 1
    fi
    echo "ATTRAPPE: Firestore-Regeln ausgerollt"; exit 0 ;;
  *)
    if [ "${ATTRAPPE_HOSTING_ROT:-0}" = "1" ]; then
      echo "ATTRAPPE: Hosting/Functions-Deploy scheitert (so gewollt)." >&2
      exit 1
    fi
    echo "ATTRAPPE: Deploy abgeschlossen"; exit 0 ;;
esac
