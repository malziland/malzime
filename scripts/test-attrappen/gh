#!/bin/sh
# Attrappe fuer die GitHub-CLI.
#
#   ATTRAPPE_CHECKS   Zeilen "name=conclusion" fuer die Pflicht-Checks.
#                     Vorgabe: alle sechs auf success.
[ -n "${ATTRAPPE_PROTOKOLL:-}" ] && echo "gh $*" >> "$ATTRAPPE_PROTOKOLL"

VORGABE='test-backend=success
test-frontend=success
test-e2e=success
secret-scan=success
playwright-version=success
pruefungen=success'

if [ "${ATTRAPPE_GH_ROT:-0}" = "1" ]; then
  echo "ATTRAPPE gh: nicht erreichbar (so gewollt)" >&2
  exit 1
fi

# Die Abkuerzung fragt ZWEI Staende ab: erst main, dann den Kopf des Pull
# Requests. Beide Abfragen tragen ihre SHA in der URL — daran lassen sie sich
# auseinanderhalten. ATTRAPPE_PR_KOPF nennt die SHA des PR-Kopfs;
# ATTRAPPE_CHECKS_PR seine Ergebnisse. Ohne beides verhaelt sich die Attrappe
# wie zuvor.
case "$1" in
  api)
    # Herkunftsnachweis des HEIC-Dekoders und Alter des Nachtlaufs: Die
    # Attrappe liefert API-JSON und wendet den uebergebenen jq-Ausdruck mit
    # ECHTEM jq an (Befund H-17). Sie prueft ausserdem die ABFRAGE (Befund
    # J-05): falscher Commit, fehlender Zweig- oder Statusfilter -> lauter
    # Fehlschlag statt einer passenden Antwort. Der erwartete Commit ist der
    # juengste mit Aenderung an Dekoder, Rezept oder Workflow im Arbeitsbaum
    # (dem Testklon).
    # ATTRAPPE_LIBHEIF_LAEUFE / ATTRAPPE_NACHT_LAEUFE: JSON wie die API.
    case "$*" in
      *"/actions/workflows/"*)
        JQ=""; VORIG=""
        for a in "$@"; do [ "$VORIG" = "--jq" ] && JQ="$a"; VORIG="$a"; done
        case "$*" in
          *"workflows/libheif-bau.yml/runs"*)
            ERWARTET=$(git log -1 --format=%H -- public/lib/libheif scripts/libheif-bauen.sh .github/workflows/libheif-bau.yml)
            case "$*" in *"head_sha=$ERWARTET"*) ;; *) echo "ATTRAPPE gh: libheif-Abfrage ohne head_sha=$ERWARTET: $*" >&2; exit 97 ;; esac
            if [ -n "${ATTRAPPE_LIBHEIF_LAEUFE:-}" ]; then JSON="$ATTRAPPE_LIBHEIF_LAEUFE"
            else JSON='{"workflow_runs":[{"created_at":"2026-09-30T10:00:00Z","status":"completed","conclusion":"success"}]}'; fi ;;
          *"workflows/sicherheit-nachts.yml/runs"*)
            case "$*" in *"branch=main"*"status=completed"*|*"status=completed"*"branch=main"*) ;;
              *) echo "ATTRAPPE gh: Nachtlauf-Abfrage ohne branch=main und status=completed: $*" >&2; exit 97 ;; esac
            if [ -n "${ATTRAPPE_NACHT_LAEUFE:-}" ]; then JSON="$ATTRAPPE_NACHT_LAEUFE"
            else JSON="{\"workflow_runs\":[{\"created_at\":\"$(node -e 'console.log(new Date(Date.now()-2*3600000).toISOString())')\",\"event\":\"schedule\",\"conclusion\":\"success\",\"head_sha\":\"$(git rev-parse HEAD)\",\"head_repository\":{\"full_name\":\"malziland/malzime\"}}]}"; fi
            # Platzhalter HEAD in ATTRAPPE_NACHT_LAEUFE wird zur Kennung des
            # Test-Commits (die Tests kennen sie beim Zusammenbauen nicht).
            JSON=$(printf '%s' "$JSON" | sed "s/\"head_sha\":\"HEAD\"/\"head_sha\":\"$(git rev-parse HEAD)\"/g") ;;
          *) echo "ATTRAPPE gh: unbekannte Workflow-Abfrage: $*" >&2; exit 97 ;;
        esac
        printf '%s' "$JSON" | jq -r "$JQ"
        exit $? ;;
    esac
    if [ -n "${ATTRAPPE_PR_KOPF:-}" ] && [ -n "${ATTRAPPE_CHECKS_PR:-}" ]; then
      case "$*" in
        *"$ATTRAPPE_PR_KOPF"*) printf '%s\n' "$ATTRAPPE_CHECKS_PR"; exit 0 ;;
      esac
    fi
    printf '%s\n' "${ATTRAPPE_CHECKS:-$VORGABE}"
    exit 0 ;;
  pr)
    echo "${ATTRAPPE_PR_KOPF:-0000000000000000000000000000000000000000}"
    exit 0 ;;
  *)
    exit 0 ;;
esac
