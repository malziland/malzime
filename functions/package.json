{
  "name": "malzime-functions",
  "private": true,
  "engines": {
    "node": "24"
  },
  "main": "src/index.js",
  "scripts": {
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --forceExit --detectOpenHandles --coverage",
    "lint": "eslint --max-warnings=0 src/",
    "lint:fix": "eslint --max-warnings=0 src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "serve": "firebase emulators:start --only functions"
  },
  "dependencies": {
    "@google-cloud/tasks": "^7.2.1",
    "busboy": "^1.6.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "json5": "^2.2.3"
  },
  "overrides": {
    "firebase-functions": {
      "firebase-admin": "$firebase-admin"
    },
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/hilfen/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
