{
  "name": "bias-demo-functions",
  "private": true,
  "engines": {
    "node": "24"
  },
  "main": "src/index.js",
  "scripts": {
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --forceExit --detectOpenHandles --coverage",
    "lint": "eslint --max-warnings=0 src/",
    "lint:fix": "eslint --max-warnings=0 src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google-cloud/tasks": "^6.3.0",
    "busboy": "^1.6.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "json5": "^2.2.3"
  },
  "overrides": {
    "firebase-functions": {
      "firebase-admin": "$firebase-admin"
    },
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint --max-warnings=0/js": "^10.0.1",
    "eslint --max-warnings=0": "^10.8.0",
    "eslint --max-warnings=0-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prettier": "^3.9.6"
  }
}
