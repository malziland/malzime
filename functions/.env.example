# Firebase Functions environment variables
# Copy to functions/.env and fill in for local development.
# In production these are managed via Firebase Secrets (defineSecret), not this file.

# Mistral AI API key — the pipeline's only AI provider since v1.6.0.
# Locally this name is fine; in production the secret is MISTRAL_API_KEY_EU (bound to europe-west1).
# MISTRAL_API_KEY=your-mistral-api-key
